# Настройки проекта, отличные от значений ESP-IDF по умолчанию (sdkconfig в git не хранится и
# создаётся из этого файла при первой сборке). Сохранить свои изменения из menuconfig: idf.py save-defconfig

# WT32-ETH01: 4 МБ flash, два слота прошивки для обновления по сети (по 1,7 МБ).
# Раздел настроек (nvs) на прежнем месте — сохранённые настройки переживают смену таблицы.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_TWO_OTA_LARGE=y

# Автооткат: новая прошивка, не подтвердившая работоспособность, при перезагрузке
# заменяется предыдущей
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Запас сокетов (веб-сервер, запросы к серверу, самопроверка после обновления) и длины
# заголовков запроса (cookie сессии, пароль при обновлении прошивки)
CONFIG_LWIP_MAX_SOCKETS=12
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
